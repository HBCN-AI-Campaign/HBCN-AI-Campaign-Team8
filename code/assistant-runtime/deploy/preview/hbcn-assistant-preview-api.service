[Unit]
Description=Huiyan isolated preview business API
After=network-online.target hbcn-assistant-preview-runtime.service
Wants=network-online.target

[Service]
Type=simple
User=hbcn-assistant-preview
Group=hbcn-assistant-preview
WorkingDirectory=/opt/hbcn-assistant-preview/current/code/backend
EnvironmentFile=/etc/hbcn-assistant-preview/backend.env
ExecStart=/opt/hbcn-assistant-preview/venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8003 --workers 1 --no-access-log
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hbcn-assistant-preview
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
