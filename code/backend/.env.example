# 复制为 .env 后按需修改

# 默认 SQLite（零依赖）。切换 PostgreSQL：
# DATABASE_URL=postgresql+psycopg2://loan:loan@localhost:5432/loan_review
DATABASE_URL=sqlite:///./loan_review.db

JWT_SECRET=change-me-in-production-please
ACCESS_TOKEN_EXPIRE_MINUTES=480
DEBUG=true

# 阿狗中转站 / OpenAI-compatible Agent SDK 网关（不提交真实密钥）
# AI_BASE_URL=https://your-gateway.example/v1
# AI_API_KEY=
# AI_MODEL=
AI_REQUEST_TIMEOUT=45

# 独立 RAG 知识库服务（code/rag-service，默认端口 8010，不提交真实 Token）
# RAG_BASE_URL=http://127.0.0.1:8010
# RAG_SERVICE_TOKEN=replace-with-same-token-as-rag-service-env
RAG_REQUEST_TIMEOUT=15
