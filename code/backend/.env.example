# 复制为 .env 后按需修改

# 默认 SQLite（零依赖）。切换 PostgreSQL：
# DATABASE_URL=postgresql+psycopg2://loan:loan@localhost:5432/loan_review
DATABASE_URL=sqlite:///./loan_review.db

JWT_SECRET=change-me-in-production-please
ACCESS_TOKEN_EXPIRE_MINUTES=480
DEBUG=true

# 汇丰比赛提供的百炼 API（OpenAI-compatible）。密钥通过部署环境 Secret 注入。
AI_BASE_URL=https://llm-tlndh47wd9ustbss.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 在本地 shell 或部署平台 Secret 中设置 AI_API_KEY；不要提交真实密钥。
AI_API_KEY=
AI_MODEL=qwen3.8-flash
AI_REQUEST_TIMEOUT=45

# 独立 RAG 知识库服务（code/rag-service，默认端口 8010）。部署时使用服务间网络地址。
RAG_BASE_URL=http://127.0.0.1:8010
# 与 rag-service 的 SERVICE_TOKEN 一致；需从部署 Secret 注入，不能使用此占位值。
RAG_SERVICE_TOKEN=replace-with-rag-service-secret
RAG_REQUEST_TIMEOUT=30
