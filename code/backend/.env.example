# ====== 数据库（阿里云 RDS PostgreSQL 16，从队内 ECS 内网连接）======
# 账号连接上限 30，应用池建议 5–10（见 DB_POOL_SIZE/DB_MAX_OVERFLOW）。
# 请填入真实用户名/密码/库名（勿提交含真实密码的 .env 到仓库）。
DATABASE_URL=postgresql+psycopg2://<USER>:<PASSWORD>@pgm-xxx.rwlb.rds.aliyuncs.com:5432/<DB>
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_PRE_PING=true

# 本地开发可改回 SQLite（默认即此，不配 DATABASE_URL 时生效）：
# DATABASE_URL=sqlite:///./loan_review.db

# ====== OCR 服务 ======
OCR_BASE_URL=http://127.0.0.1:7888

# ====== 规则核对服务（对方同事）======
# 留空 → 直接走本地内置 rule_engine。
# 配置后：核对前先探 {RULE_CHECK_BASE_URL}{RULE_CHECK_HEALTH_PATH}，
#         ready 才调 {RULE_CHECK_BASE_URL}{RULE_CHECK_PATH}，否则回退本地引擎。
RULE_CHECK_BASE_URL=
RULE_CHECK_HEALTH_PATH=/health
RULE_CHECK_PATH=/rule_check
RULE_CHECK_TIMEOUT=30
RULE_CHECK_HEALTH_TIMEOUT=3

# ====== JWT ======
JWT_SECRET=change-me-in-production-please
