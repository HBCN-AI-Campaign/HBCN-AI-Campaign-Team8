# 复制为 .env 后按需修改

# 默认 SQLite（零依赖）。切换 PostgreSQL：
# DATABASE_URL=postgresql+psycopg2://loan:loan@localhost:5432/loan_review
DATABASE_URL=sqlite:///./loan_review.db

JWT_SECRET=change-me-in-production-please
ACCESS_TOKEN_EXPIRE_MINUTES=480
DEBUG=true

# HSBC provider base URL, model id and key are configured only in
# code/assistant-runtime/.env, then injected into the isolated OpenCode runtime.
AI_REQUEST_TIMEOUT=45

# OpenCode SDK runtime (Bun, see code/assistant-runtime). Keep it on the private network.
ASSISTANT_RUNTIME_URL=http://127.0.0.1:8090
# Use the same strong random value in ASSISTANT_RUNTIME_TOKEN in the runtime environment.
ASSISTANT_RUNTIME_TOKEN=replace-with-runtime-secret

# 独立 RAG 知识库服务（code/rag-service，默认端口 8010）。部署时使用服务间网络地址。
RAG_BASE_URL=http://127.0.0.1:8010
# 与 rag-service 的 SERVICE_TOKEN 一致；需从部署 Secret 注入，不能使用此占位值。
RAG_SERVICE_TOKEN=replace-with-rag-service-secret
RAG_REQUEST_TIMEOUT=30
