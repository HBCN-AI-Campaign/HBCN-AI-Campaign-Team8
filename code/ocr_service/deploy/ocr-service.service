[Unit]
Description=OCR Document Recognition Service
After=network.target

[Service]
# 改成实际运行用户（如 www-data 或你的用户名）
User=www-data
WorkingDirectory=/opt/ocr_service
Environment=PADDLE_PDX_MODEL_SOURCE=BOS
Environment=PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
ExecStart=/opt/ocr_service/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
