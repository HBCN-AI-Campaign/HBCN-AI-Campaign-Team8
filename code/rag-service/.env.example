SERVICE_TOKEN=replace-with-a-long-random-secret
BUSINESS_SOURCE_ROOT=
RAG_ENGINE=postgres
RAG_DATABASE_URL=
RAG_DATABASE_RESOURCE_FILE=
RAG_SSH_RESOURCE_FILE=
RAG_SSH_HOST_KEY_SHA256=
RAG_POSTGRES_SSLMODE=require
RAG_DATABASE_SCHEMA=hbcn_rag
RAG_VECTOR_TABLE=chunks_v1
EMBEDDING_DIMENSIONS=1024
RAG_DATA_DIR=data
RAG_MAX_DOCUMENT_PAGES=500
RAG_MAX_TEXT_CHARS=2000000
RAG_RETRIEVAL_MIN_SCORE=0.35
RAG_MAX_CONCURRENT_JOBS=2
ASSISTANT_RUNTIME_URL=http://127.0.0.1:8090
ASSISTANT_RUNTIME_TOKEN=
ASSISTANT_RUNTIME_RESOURCE_FILE=
RAG_ANSWER_TIMEOUT_SECONDS=90
RAG_TOTAL_TIMEOUT_SECONDS=240
RAG_MAX_QUERY_VARIANTS=4
RAG_MAX_RETRIEVAL_QUERIES=6
RAG_MAX_RETRIEVAL_ROUNDS=2
RAG_MAX_CONTEXT_WINDOWS=80
RAG_MAX_CONTEXT_BATCHES=6
# Curator-owned JSON registry; never trust source metadata as legal approval.
RAG_LEGAL_REVIEW_FILE=
# 独立历史案例/经验管理；默认关闭。主体注册表在受控部署路径，不放仓库。
RAG_REFERENCES_ENABLED=false
RAG_REFERENCE_PRINCIPALS_FILE=
# 文档解析质量复核：独立服务端审核主体注册表；为空时接口关闭
RAG_DOCUMENT_REVIEW_PRINCIPALS_FILE=
# Run python -m app.lexical_index --apply before enabling hybrid on an existing index.
RAG_SEARCH_MODE=vector
PKULAW_MCP_ENABLED=false
PKULAW_MCP_TOKEN=
PKULAW_MCP_LAW_SEARCH_URL=https://apim-gateway.pkulaw.com/mcp-law-search-service
PKULAW_MCP_TIMEOUT_SECONDS=30
PKULAW_MCP_MAX_QUERIES=2
# Dedicated reranker. API shape only; this does not provision a model or authorize external data flow.
RAG_RERANK_PROVIDER=disabled
RAG_RERANK_URL=
RAG_RERANK_TOKEN=
RAG_RERANK_MODEL=
RAG_RERANK_REVISION=
RAG_RERANK_ALLOW_EXTERNAL=false
RAG_RERANK_TIMEOUT_SECONDS=20
RAGFLOW_BASE_URL=http://127.0.0.1:9380
RAGFLOW_API_KEY=
RAGFLOW_BUSINESS_RULES_DATASET_ID=
RAGFLOW_PROJECT_DESIGN_DATASET_ID=
RAGFLOW_BUSINESS_RULES_DATASET_NAME=hbcn-team8-business-rules
RAGFLOW_PROJECT_DESIGN_DATASET_NAME=hbcn-team8-project-design
RAGFLOW_LANGUAGE=Chinese
RAGFLOW_PARSER_ID=general
REQUEST_TIMEOUT_SECONDS=60
MAX_UPLOAD_BYTES=52428800
UPLOAD_TIMEOUT_SECONDS=900
PARSE_POLL_INTERVAL_SECONDS=5
PARSE_POLL_TIMEOUT_SECONDS=900

# --- PostgreSQL / 本地引擎共用的百炼向量配置 ---
# 百炼 OpenAI 兼容地址 + Key（不提交真实密钥）
# BAILIAN_BASE_URL=https://llm-xxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# BAILIAN_API_KEY=
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
LOCAL_STORE_PATH=rag_store.sqlite3
# 队友 ocr_demo 服务地址；不可用时图片会回退到百炼视觉 OCR
OCR_BASE_URL=http://127.0.0.1:8001
OCR_TIMEOUT_SECONDS=300
OCR_VISION_MODEL=qwen3.8-flash
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# Caller-supplied web snapshots; no arbitrary URL fetching. Independent reader key registry.
RAG_WEB_CONTEXT_ENABLED=false
RAG_WEB_CONTEXT_PRINCIPALS_FILE=
# Exact HTTPS DNS hostnames, comma separated. No wildcard/subdomain expansion.
RAG_WEB_CONTEXT_ALLOWED_HOSTS=
RAG_WEB_CONTEXT_MAX_AGE_SECONDS=900
