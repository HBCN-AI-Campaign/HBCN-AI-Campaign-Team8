[Unit]
Description=HBCN independent RAG service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hbcn-rag
Group=hbcn-rag
WorkingDirectory=/opt/hbcn-rag
EnvironmentFile=/etc/hbcn-rag/rag.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=RAG_DATA_DIR=/var/lib/hbcn-rag
ExecStart=/opt/hbcn-rag/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8011 --workers 1
Restart=on-failure
RestartSec=5
TimeoutStopSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hbcn-rag

[Install]
WantedBy=multi-user.target
