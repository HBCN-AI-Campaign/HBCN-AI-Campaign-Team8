flowchart TD
  RAW["历史审核原件与结论<br/>业务系统保管"] --> SCREEN["授权与质量检查<br/>脱敏 / 结论状态 / 依据版本 / 保留期限"]
  SCREEN --> DRAFT["不可变候选版本<br/>范围 / 正反依据 / hash / 泄漏组"]
  DRAFT --> REVIEW["独立人员复核<br/>身份与权限来自服务端 / 禁止自批"]
  REVIEW -->|"通过复核"| CASE["独立案例库<br/>案件事实 + 证据 + 结果 + 适用边界"]
  SCREEN -->|"未复核或被撤销"| HOLD["隔离或排除<br/>不参与指导性召回"]
  CASE --> SIM["相似案例检索<br/>司法辖区 / 时间 / 产品 / 差异类型"]
  SIM --> REF["回答中单列历史参考<br/>不能替代现行规范或本案事实"]
  CASE --> CAND["提炼候选经验<br/>多案例支持 / 失败反例 / 原始证据"]
  CAND --> HUMAN["业务人员审批与版本发布<br/>至少两个不同案件 / 来源版本绑定 / 不晚于来源到期"]
  HUMAN --> MEM["经验记忆<br/>检索策略 / 检查清单 / 适用条件"]
  MEM --> GUIDE["供 Agent 计划与流程建议使用"]
  CHANGE["纠错 / 撤销 / 到期 / 政策更新"] --> INVALID["失效传播<br/>案例索引 / 派生记忆 / 缓存 / 评测关联"]
  INVALID -.-> CASE
  INVALID -.-> MEM
  AUDIT["事务审计与读取记录<br/>失效时立即拒绝读取 / 到期清空正文"] -.-> CASE
  AUDIT -.-> MEM
