flowchart TD
  SOURCE["原件与登记 SHA256<br/>校验存储内容未变化"] --> PARSE["逐页 / 章节解析<br/>原生文本优先，必要时 OCR<br/>记录解析方法及不完整信号"]
  PARSE --> CHECK["版本化机械检查<br/>字符 / 空单元 / 字形 / 截断<br/>原件、解析与报告 hash 分别绑定"]
  CHECK -->|"无效字符或无可用正文"| BLOCK["quarantined<br/>不向量化、不参与检索"]
  CHECK -->|"OCR / 空单元 / 结构或编码不确定"| PENDING["quality_review<br/>保存待核对解析，不参与检索"]
  CHECK -->|"机械检查通过"| INDEX["切片、Embedding、词法索引<br/>最终发布事务仍检查撤回"]
  HUMAN["获授权审核人<br/>独立服务端凭证、精确范围、期限"] --> REVIEW["逐单元对照原件<br/>确认三个 hash 与全部核对单元<br/>不能审批掉无效字符"]
  PENDING --> REVIEW
  REVIEW -->|"reject"| REJECT["failed / quality_rejected<br/>更正原件或解析后重新检查"]
  REVIEW -->|"approve"| APPROVED["记录本版复核声明<br/>queued，复用已审核解析<br/>不再次 OCR 改变正文"]
  APPROVED --> INDEX
  INDEX --> READY["ready<br/>基础检查或本版人工复核<br/>不等于 OCR 准确率 / 法规适用性通过"]
  READY --> FILTER["检索与答复返回前复核<br/>当前质量策略、状态与版本<br/>沿用文档撤回屏障"]
  LEGACY["旧索引缺本版质量报告<br/>默认排除，ready 检查报告缺口"] --> RECHECK["授权 quality-recheck<br/>先隐藏旧片段，重新解析<br/>不批量自动放行"]
  HUMAN --> RECHECK
  RECHECK --> SOURCE
