# Copy to .env only on your own computer. Never commit credentials.
PORT=4178
# Existing, isolated OpenCode server. Empty means offline mode.
OPENCODE_BASE_URL=
OPENCODE_SERVER_USERNAME=
OPENCODE_SERVER_PASSWORD=
# Optional native Codex CLI executable; empty means offline when OpenCode is unset.
CODEX_CLI_PATH=
CODEX_CLI_MODEL=gpt-6.1-sol
CODEX_CLI_REASONING_EFFORT=medium
